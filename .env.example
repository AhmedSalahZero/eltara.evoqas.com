# ══════════════════════════════════════════════════════════════════
#  El Tara — Settings file (copy this to .env and fill it in)
#  Location: .env.example
#
#  .env holds passwords and secret keys: it is NEVER put in a zip,
#  emailed or shared. docs/SETUP.md explains every line you need.
# ══════════════════════════════════════════════════════════════════

APP_NAME="El Tara"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# debug = everything (fine on your computer). On the LIVE server use warning.
LOG_LEVEL=debug

# ── Database (the one you created: el_tara, utf8mb4_unicode_ci) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=el_tara
DB_USERNAME=root
DB_PASSWORD=

# ── Sessions, cache, background work ──────────────────────────────
# On your computer these use the database. On the live server
# (500 companies) switch all three to redis — docs/ARCHITECTURE.md.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
TRIP_FILES_DISK_DRIVER=local

# ── Email (activation links, reset links, subscription warnings) ──
# "log" writes emails into storage/logs instead of sending them —
# fine while building. Put your real mail server here later.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@eltara.app"
MAIL_FROM_NAME="El Tara"

# ── Your platform account (created by: php artisan db:seed) ──────
SUPER_ADMIN_EMAIL=admin@eltara.app
SUPER_ADMIN_NAME="El Tara Admin"
# At least 8 characters with a capital letter, a number and a symbol.
DEFAULT_PASSWORD=

# ── Shown to companies on the "subscription ending" banner ───────
SUPPORT_EMAIL=
SUPPORT_PHONE=

VITE_APP_NAME="${APP_NAME}"

# Behind a load balancer / hosting proxy: its address(es), comma-separated, or * if the app is only reachable through it.
# Leave empty when there is no proxy. Without this, every user looks like one IP address.
TRUSTED_PROXIES=
# Documents (licence, insurance, inspection) turn amber this many days before they end.
DOCUMENT_ALERT_DAYS=30
# Custody per trip may exceed the planned custody by this percent before only the company admin can add more.
CUSTODY_CAP_PERCENT=50
